    {
      "id": "b1-d03-dialogue-00",
      "book": 1,
      "day": 3,
      "type": "dialogue",
      "index": 0,
      "bosnian": "Dobar dan! Molim?",
      "english": "Good day! Yes? / What can I get you?",
      "pronunciation": "",
      "preferredGender": "female",
      "speaker": "Amira",
      "conversationTitle": "Kod Amire",
      "s3Key": "clips/b1-d03-dialogue-00"
    },
    {
      "id": "b1-d03-dialogue-01",
      "book": 1,
      "day": 3,
      "type": "dialogue",
      "index": 1,
      "bosnian": "Dobar dan! Jednu kahvu, molim.",
      "english": "Good day! One coffee, please.",
      "pronunciation": "",
      "preferredGender": "female",
      "speaker": "Ana",
      "conversationTitle": "Kod Amire",
      "s3Key": "clips/b1-d03-dialogue-01"
    },
    {
      "id": "b1-d03-dialogue-02",
      "book": 1,
      "day": 3,
      "type": "dialogue",
      "index": 2,
      "bosnian": "I ja — jednu kahvu. Dva fildžana.",
      "english": "And me — one coffee. Two cups.",
      "pronunciation": "",
      "preferredGender": "male",
      "speaker": "Emir",
      "conversationTitle": "Kod Amire",
      "s3Key": "clips/b1-d03-dialogue-02"
    },
    {
      "id": "b1-d03-dialogue-03",
      "book": 1,
      "day": 3,
      "type": "dialogue",
      "index": 3,
      "bosnian": "Dobro. Koliko lokuma? Jedan? Dva?",
      "english": "Good. How many lokum? One? Two?",
      "pronunciation": "",
      "preferredGender": "female",
      "speaker": "Amira",
      "conversationTitle": "Kod Amire",
      "s3Key": "clips/b1-d03-dialogue-03"
    },
    {
      "id": "b1-d03-dialogue-04",
      "book": 1,
      "day": 3,
      "type": "dialogue",
      "index": 4,
      "bosnian": "Dva, molim. Hvala!",
      "english": "Two, please. Thank you!",
      "pronunciation": "",
      "preferredGender": "female",
      "speaker": "Ana",
      "conversationTitle": "Kod Amire",
      "s3Key": "clips/b1-d03-dialogue-04"
    },
    {
      "id": "b1-d03-dialogue-05",
      "book": 1,
      "day": 3,
      "type": "dialogue",
      "index": 5,
      "bosnian": "Molim! Kahva je tu.",
      "english": "You’re welcome! The coffee is here.",
      "pronunciation": "",
      "preferredGender": "female",
      "speaker": "Amira",
      "conversationTitle": "Kod Amire",
      "s3Key": "clips/b1-d03-dialogue-05"
    },
    {
      "id": "b1-d03-dialogue-06",
      "book": 1,
      "day": 3,
      "type": "dialogue",
      "index": 6,
      "bosnian": "Mrvica skače. Ana: Zdravo, Mrvica!",
      "english": "Mrvica jumps up. Ana: Hello, Mrvica!",
      "pronunciation": "",
      "preferredGender": "any",
      "speaker": "Narrator",
      "conversationTitle": "Kod Amire",
      "s3Key": "clips/b1-d03-dialogue-06"
    },
    {
      "id": "b1-d03-dialogue-07",
      "book": 1,
      "day": 3,
      "type": "dialogue",
      "index": 7,
      "bosnian": "Ona je Mrvica. Mačka!",
      "english": "She is Mrvica. A cat!",
      "pronunciation": "",
      "preferredGender": "male",
      "speaker": "Emir",
      "conversationTitle": "Kod Amire",
      "s3Key": "clips/b1-d03-dialogue-07"
