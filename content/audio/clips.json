      "book": 1,
      "day": 2,
      "type": "dialogue",
      "index": 0,
      "bosnian": "Zdravo! Ti si Ana?",
      "english": "Hello! Are you Ana?",
      "pronunciation": "",
      "preferredGender": "male",
      "speaker": "Emir",
      "conversationTitle": "Kod Sebilja",
      "s3Key": "clips/b1-d02-dialogue-00"
    },
    {
      "id": "b1-d02-dialogue-01",
      "book": 1,
      "day": 2,
      "type": "dialogue",
      "index": 1,
      "bosnian": "Da! Ja sam Ana. Zovem se Ana.",
      "english": "Yes! I am Ana. My name is Ana.",
      "pronunciation": "",
      "preferredGender": "female",
      "speaker": "Ana",
      "conversationTitle": "Kod Sebilja",
      "s3Key": "clips/b1-d02-dialogue-01"
    },
    {
      "id": "b1-d02-dialogue-02",
      "book": 1,
      "day": 2,
      "type": "dialogue",
      "index": 2,
      "bosnian": "Drago mi je! Ja sam Emir.",
      "english": "Nice to meet you! I am Emir.",
      "pronunciation": "",
      "preferredGender": "male",
      "speaker": "Emir",
      "conversationTitle": "Kod Sebilja",
      "s3Key": "clips/b1-d02-dialogue-02"
    },
    {
      "id": "b1-d02-dialogue-03",
      "book": 1,
      "day": 2,
      "type": "dialogue",
      "index": 3,
      "bosnian": "Drago mi je, Emir. Ti si iz Sarajeva?",
      "english": "Nice to meet you, Emir. Are you from Sarajevo?",
      "pronunciation": "",
      "preferredGender": "female",
      "speaker": "Ana",
      "conversationTitle": "Kod Sebilja",
      "s3Key": "clips/b1-d02-dialogue-03"
    },
    {
      "id": "b1-d02-dialogue-04",
      "book": 1,
      "day": 2,
      "type": "dialogue",
      "index": 4,
      "bosnian": "Da. Ja sam iz Sarajeva. On — Sebilj — je tu.",
      "english": "Yes. I am from Sarajevo. That — Sebilj — is here.",
      "pronunciation": "",
      "preferredGender": "male",
      "speaker": "Emir",
      "conversationTitle": "Kod Sebilja",
      "s3Key": "clips/b1-d02-dialogue-04"
    },
    {
      "id": "b1-d02-dialogue-05",
      "book": 1,
      "day": 2,
      "type": "dialogue",
      "index": 5,
      "bosnian": "Hvala! Ti si vodič?",
      "english": "Thank you! Are you a guide?",
      "pronunciation": "",
      "preferredGender": "female",
      "speaker": "Ana",
      "conversationTitle": "Kod Sebilja",
      "s3Key": "clips/b1-d02-dialogue-05"
    },
    {
      "id": "b1-d02-dialogue-06",
      "book": 1,
      "day": 2,
      "type": "dialogue",
      "index": 6,
      "bosnian": "Da, ja sam vodič. Idemo!",
      "english": "Yes, I am a guide. Let’s go!",
      "pronunciation": "",
      "preferredGender": "male",
      "speaker": "Emir",
      "conversationTitle": "Kod Sebilja",
      "s3Key": "clips/b1-d02-dialogue-06"
    },
    {
      "id": "b1-d02-dialogue-07",
      "book": 1,
      "day": 2,
      "type": "dialogue",
      "index": 7,
      "bosnian": "Mrvica gleda. Sutra: kahva.",
      "english": "Mrvica watches. Tomorrow: coffee.",
      "pronunciation": "",
      "preferredGender": "any",
      "speaker": "Narrator",
      "conversationTitle": "Kod Sebilja",
      "s3Key": "clips/b1-d02-dialogue-07"
