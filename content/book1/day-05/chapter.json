  "grammar": [
    {
      "title": "Gdje je…?",
      "explanation": "Gdje? means where. Pair it with je for a ready question: Gdje je Mostar? Gdje je mapa? Gdje je Amira? Answer with a place chunk or with ovdje / tamo.",
      "examples": [
        {
          "bosnian": "Gdje je Mostar?",
          "english": "Where is Mostar?"
        },
        {
          "bosnian": "Gdje je mapa?",
          "english": "Where is the map?"
        },
        {
          "bosnian": "Gdje je Emir?",
          "english": "Where is Emir?"
        }
      ]
    },
    {
      "title": "Ovdje and tamo",
      "explanation": "Ovdje = here (near you). Tamo = there / over there (farther away). On a map Emir points: Sarajevo je ovdje. Mostar je tamo. Practice pointing while you speak — gesture is half the lesson.",
      "examples": [
        {
          "bosnian": "Ovdje je Sarajevo.",
          "english": "Here is Sarajevo."
        },
        {
          "bosnian": "Mostar je tamo.",
          "english": "Mostar is over there."
        },
        {
          "bosnian": "Mrvica je ovdje!",
          "english": "Mrvica is here!"
        }
      ]
    },
    {
      "title": "U / na / kod — say them as chunks",
      "explanation": "Memorize useful place lines before full case tables. U Sarajevu = in Sarajevo. Na mapi = on the map. Kod Amire = at Amira’s. Na jugu = in the south. Learn the whole chunk; morphology details come later.",
      "examples": [
        {
          "bosnian": "U Sarajevu.",
          "english": "In Sarajevo."
        },
        {
          "bosnian": "Na mapi.",
          "english": "On the map."
        },
        {
          "bosnian": "Kod Amire.",
          "english": "At Amira’s."
        }
      ]
    }
  ],
  "culture": {
    "title": "Mostar on the map — a trip for later",
    "body": "Bosnia and Herzegovina stretches from green hills to the Neretva valley. Sarajevo sits in a bowl of mountains; Mostar lies farther south, famous for Stari Most — the Old Bridge — leaping the cold river. Emir will not spoil the ending: Ana will get there near the end of Book 1. Today she only finds Mostar on the map, says Gdje je Mostar?, and hears the tease: Tamo. Sutra… ili uskoro!",
    "imageId": "bih-map"
  },
  "lessonBlocks": [
    {
      "id": "a",
      "title": "Lesson A — Gdje / ovdje / tamo",
      "body": "Ask Gdje je…? about anything on the table: mapa, kahva, Mrvica. Answer Ovdje! when it is near, Tamo! when you point away. Add city names: Gdje je Sarajevo? — Ovdje. Gdje je Mostar? — Tamo. Drill ten times with a finger on an imaginary map. Emir makes Ana point south for Mostar every time she asks.",
      "tips": [
        "Question kit: Gdje je + place?",
        "Answer kit: Ovdje. / Tamo."
      ]
    },
    {
      "id": "b",
      "title": "Lesson B — On the map of BiH",
      "body": "Open the map. Say Na mapi. Find Sarajevo: U Sarajevu — ovdje. Find Mostar: Mostar je tamo, na jugu. Name the river and bridge as story bait: Neretva je rijeka. Stari most. Then place yourselves: Mi smo kod Amire, u Sarajevu. Emir grins: Mostar? Uskoro. Ana writes Gdje je Mostar? in her notebook and draws a tiny bridge.",
      "tips": [
        "Chunks: u Sarajevu · na mapi · kod Amire · na jugu",
        "Reuse je from Lesson 2"
      ]
    }
  ],
  "conversation": {
    "title": "Mapa na stolu",
    "setting": "Amira’s café. A paper map of BiH on the table beside two fildžans.",
    "lines": [
      {
        "speaker": "Emir",
        "bosnian": "Ana, gdje je mapa?",
        "english": "Ana, where is the map?"
      },
      {
        "speaker": "Ana",
        "bosnian": "Ovdje! Na stolu.",
        "english": "Here! On the table."
      },
      {
        "speaker": "Emir",
        "bosnian": "Dobro. Gdje je Sarajevo?",
        "english": "Good. Where is Sarajevo?"
      },
      {
        "speaker": "Ana",
        "bosnian": "Ovdje. U Sarajevu smo.",
        "english": "Here. We are in Sarajevo."
      },
      {
        "speaker": "Emir",
        "bosnian": "A Mostar? Gdje je Mostar?",
        "english": "And Mostar? Where is Mostar?"
      },
      {
        "speaker": "Ana",
        "bosnian": "Tamo… na jugu?",
        "english": "There… in the south?"
      },
      {
        "speaker": "Emir",
        "bosnian": "Da! Mostar je tamo. Stari most, rijeka Neretva…",
        "english": "Yes! Mostar is there. The Old Bridge, the Neretva river…"
      },
      {
        "speaker": "Amira",
        "bosnian": "Ali danas — kahva kod Amire!",
        "english": "But today — coffee at Amira’s!"
      }
    ]
  },
