  "grammar": [
    {
      "title": "Koliko je sati?",
      "explanation": "Ask the time with Koliko je sati? Answer with a number from Lesson 3 plus sat or sati. Jedan je sat (1:00). For 2–4 you will often hear dva/tri/četiri sata in real speech — for this lesson, memorize the friendly pattern X je sati for 5–12 and Jedan je sat for 1. Also say U osam sati (at eight o’clock) as a chunk.",
      "examples": [
        {
          "bosnian": "Koliko je sati?",
          "english": "What time is it?"
        },
        {
          "bosnian": "Jedan je sat.",
          "english": "It is one o’clock."
        },
        {
          "bosnian": "Osam je sati. / U osam sati.",
          "english": "It is eight. / At eight o’clock."
        }
      ]
    },
    {
      "title": "Danas and sutra",
      "explanation": "Danas = today. Sutra = tomorrow. Pair them with a weekday: Danas je petak. Sutra je subota. You can also place plans: Sutra u deset sati — kod Amire.",
      "examples": [
        {
          "bosnian": "Danas je petak.",
          "english": "Today is Friday."
        },
        {
          "bosnian": "Sutra je subota.",
          "english": "Tomorrow is Saturday."
        },
        {
          "bosnian": "Sutra u deset sati.",
          "english": "Tomorrow at ten o’clock."
        }
      ]
    },
    {
      "title": "Weekdays — chant the week",
      "explanation": "Learn the seven days as a list: ponedjeljak, utorak, srijeda, četvrtak, petak, subota, nedjelja. Watch četvrtak (č) and srijeda / nedjelja. Do not worry about full case endings yet — say Danas je… + the day name.",
      "examples": [
        {
          "bosnian": "ponedjeljak, utorak, srijeda",
          "english": "Mon, Tue, Wed"
        },
        {
          "bosnian": "četvrtak, petak",
          "english": "Thu, Fri"
        },
        {
          "bosnian": "subota, nedjelja",
          "english": "Sat, Sun"
        }
      ]
    }
  ],
  "culture": {
    "title": "Sahat-kula and the city’s clock",
    "body": "Near Gazi Husrev-beg’s mosque stands the Sahat-kula — Sarajevo’s clock tower — once set to lunar time for prayer. The city still has a rhythm: slow jutro with kahva, bright podne when stone streets bake, soft večer when Baščaršija fills again. Ana learns not only numbers on a watch, but when Emir says kasno and when Amira’s chairs are free. Time here is both the clock and the café.",
    "imageId": "sahat-kula"
  },
  "lessonBlocks": [
    {
      "id": "a",
      "title": "Lesson A — Ask the time",
      "body": "Drill Koliko je sati? then answer with Lesson 3 numbers: Pet je sati. Osam je sati. Deset je sati. Jedan je sat. Add place chunks: U osam sati — kod Amire. U dvanaest sati — podne. Point at a watch or phone and swap roles with Emir. Ana keeps saying Kasno je! when she is late for kahva.",
      "tips": [
        "Question kit: Koliko je sati?",
        "Reuse numbers 1–12 from Lesson 3"
      ]
    },
    {
      "id": "b",
      "title": "Lesson B — Days and the week’s plan",
      "body": "Chant the weekdays twice. Then build real lines: Danas je petak. Sutra je subota. Mark parts of day: jutro, podne, popodne, večer. Emir sketches Ana’s week on a napkin: ponedjeljak — mapa; srijeda — porodica; petak — kahva; subota — spor dan. End with one plan: Sutra u deset sati, kod Amire!",
      "tips": [
        "Danas / sutra + weekday",
        "četvrtak and srijeda need careful letters"
      ]
    }
  ],
  "conversation": {
    "title": "Koliko je sati, Emire?",
    "setting": "Outside Amira’s, late afternoon. Ana checks her phone; Emir points toward the old town clock.",
    "lines": [
      {
        "speaker": "Ana",
        "bosnian": "Emire, koliko je sati?",
        "english": "Emir, what time is it?"
      },
      {
        "speaker": "Emir",
        "bosnian": "Pet je sati. Popodne.",
        "english": "It is five o’clock. Afternoon."
      },
      {
        "speaker": "Ana",
        "bosnian": "Kasno je? Kahva?",
        "english": "Is it late? Coffee?"
      },
      {
        "speaker": "Emir",
        "bosnian": "Ne. Kod Amire — sada!",
        "english": "No. At Amira’s — now!"
      },
      {
        "speaker": "Amira",
        "bosnian": "Dobar dan! Danas je petak.",
        "english": "Good day! Today is Friday."
      },
      {
        "speaker": "Ana",
        "bosnian": "Sutra je subota?",
        "english": "Tomorrow is Saturday?"
      },
      {
        "speaker": "Emir",
        "bosnian": "Da. Sutra u deset sati — ovdje!",
        "english": "Yes. Tomorrow at ten o’clock — here!"
      },
      {
        "speaker": "Amira",
        "bosnian": "Dobro. Jutro je bolje za kahvu.",
        "english": "Good. Morning is better for coffee."
      }
    ]
  },
